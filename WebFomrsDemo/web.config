<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection" 
         connectionString="Data Source=(LocalDb)\MSSQLLocalDB;Initial Catalog=WebFormsDemo;Integrated Security=True" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  -->


  <system.web>
    <!-- Режим отладки. В продакшене установите false. -->
    <compilation debug="true" targetFramework="4.7.2" />

    <!-- Целевая версия .NET Framework для runtime -->
    <httpRuntime targetFramework="4.7.2" 
                 requestValidationMode="4.5" 
                 enableVersionHeader="false" />

    <!-- Аутентификация на основе форм -->
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" 
             timeout="30" 
             defaultUrl="Search.aspx" 
             cookieless="UseCookies" 
             slidingExpiration="true" />
    </authentication>

    <!-- Глобальный запрет анонимного доступа -->
    <authorization>
      <deny users="?" />
    </authorization>

    <!-- Настройки страниц (можно настроить под себя) -->
    <pages controlRenderingCompatibilityVersion="4.0" 
           clientIDMode="AutoID" 
           validateRequest="true" />

    <!-- Настройки сессии (по умолчанию InProc) -->
    <sessionState mode="InProc" 
                  cookieless="UseCookies" 
                  timeout="20" />

    <!-- Настройки компиляции для отладки (можно убрать) -->
    <customErrors mode="Off" />
  </system.web>

  <!-- ===================================================== -->
  <!-- Разрешаем анонимный доступ к странице входа           -->
  <!-- ===================================================== -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <!-- Модули и обработчики -->
    <modules runAllManagedModulesForAllRequests="true" />
    <validation validateIntegratedModeConfiguration="false" />

    <!-- Стандартные обработчики для ASP.NET Web Forms -->
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <!-- Запрет листинга директорий -->
    <directoryBrowse enabled="false" />

    <!-- Сжатие и кэширование (опционально) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Безопасность (опционально) -->
    <security>
      <requestFiltering>
        <!-- Максимальный размер запроса (30 МБ) -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Пример: перенаправление версий, если нужно -->
    </assemblyBinding>
  </runtime>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" 
                extension=".cs" 
                type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" 
                warningLevel="4" 
                compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
    </compilers>
  </system.codedom>

</configuration>
